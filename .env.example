# Copy this file to .env and fill in the real values. .env is gitignored.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-key-here

# Optional: override the model (defaults to gemini-2.5-flash, falls back to 2.0-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Optional: only needed in production (Render). Locally, data is saved to a JSON file.
# MONGO_URI=mongodb+srv://...
